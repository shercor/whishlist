# ---------------------------------------------------------------------------
# .env de la RAÍZ -> lo lee docker compose (NO Laravel).
# Copia a .env y ajusta puertos si chocan con otro proyecto:
#   cp .env.example .env
#
# Las credenciales de BD de aquí se sincronizan a laravel/.env con `make env`,
# así que solo las editas en este archivo.
# ---------------------------------------------------------------------------

# Prefijo de los contenedores y del proyecto: whishlist_app, whishlist_db, ...
APP_NAME=whishlist

# Puertos expuestos en el host. Cámbialos si ya están ocupados.
HTTP_PORT=8080
DB_PORT=3309
REDIS_PORT=6380
VITE_PORT=5174

# Credenciales de la base de datos.
DB_DATABASE=whishlist_db
DB_USERNAME=whishlist
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root_secret

# Nota: UID/GID no van aquí. El Makefile los exporta con id -u / id -g, y bash
# no deja sobrescribir UID al leer este archivo. Si levantas sin make, usa:
#   UID=$(id -u) GID=$(id -g) docker compose up -d --build
